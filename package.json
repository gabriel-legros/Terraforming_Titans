{
  "name": "terraforming-titans",
  "version": "1.1.51",
  "private": true,
  "productName": "Terraforming Titans",
  "main": "electron/main.cjs",
  "scripts": {
    "audit:memory": "node scripts/manual-tests/run-chrome-memory-repro.js --audit",
    "equilibrate:world": "node scripts/equilibrate-story-world.js",
    "audit:localization": "node scripts/audit-localization.js",
    "mod:generate-english-base": "bash scripts/generate-base-english-language.sh",
    "mod:seed-english-translations": "node scripts/translation-workflow.js seed-english all",
    "mod:validate-translations": "node scripts/validate-language-mods.js",
    "screenshot:ui": "node scripts/capture-game-ui.js",
    "screenshot:visualizer": "node scripts/capture-world-visualizer.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "electron:dev": "electron .",
    "test": "jest"
  },
  "build": {
    "appId": "com.terraformingtitans.game",
    "productName": "Terraforming Titans",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "LICENSES/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "LICENSES",
        "to": "LICENSES"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "assets/images/cover_small.png"
    },
    "mac": {
      "target": "dir",
      "icon": "assets/images/cover_small.png"
    },
    "linux": {
      "target": "dir",
      "icon": "assets/images/cover_small.png",
      "category": "Game"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-jest": "^30.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.61.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/__tests__/helpers/terraforming-parameters-setup.js"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/dist/",
      "/__tests__/automation-preset-json-regenerate\\.test\\.js$",
      "/__tests__/colony-need-productivity\\.test\\.js$",
      "/__tests__/deeper-mining-cost\\.test\\.js$",
      "/__tests__/furnace-expansion-tooltip-save\\.test\\.js$",
      "/__tests__/galactic-market-step-save\\.test\\.js$",
      "/__tests__/galaxy-defense-load-auto-attack\\.test\\.js$",
      "/__tests__/hephaestus-yard-duration-save\\.test\\.js$",
      "/__tests__/hydra-net-accounting\\.test\\.js$",
      "/__tests__/index\\.test\\.js$",
      "/__tests__/kessler-drag-line-water-pressure\\.test\\.js$",
      "/__tests__/late-game-ui-memory-leaks\\.test\\.js$",
      "/__tests__/nanotech-characterization\\.test\\.js$",
      "/__tests__/orbital-surplus-trading\\.test\\.js$",
      "/__tests__/planet-crackers-travel\\.test\\.js$",
      "/__tests__/repeatable-expansion-accounting\\.test\\.js$",
      "/__tests__/research-subtab-world-load\\.test\\.js$",
      "/__tests__/research-travel-effects\\.test\\.js$",
      "/__tests__/rwg-dynamic-mass-travel\\.test\\.js$",
      "/__tests__/solar-panel-maintenance\\.test\\.js$",
      "/__tests__/space-elevator-birch-world-restore\\.test\\.js$",
      "/__tests__/space-mirror-advanced-oversight-convergence\\.test\\.js$",
      "/__tests__/space-storage-transfer-accounting\\.test\\.js$",
      "/__tests__/surface-food-overflow\\.test\\.js$",
      "/__tests__/tmp-rwg-equilibration-water\\.test\\.js$",
      "/__tests__/underground-expansion-cost\\.test\\.js$",
      "/__tests__/water-pump-mass-conservation\\.test\\.js$"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!jsdom|abab|cssom|cssstyle|data-urls|decimal.js|domexception|html-encoding-sniffer|is-potential-custom-element-name|nwsapi|parse5|saxes|symbol-tree|tough-cookie|w3c-xmlserializer|webidl-conversions|whatwg-url|xml-name-validator)"
    ]
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}
